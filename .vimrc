" Vim configurations

"Set the numbers to show 
set number
set numberwidth=4

"Do detect the file type that I am detectable
filetype off

"tab key moves two spaces
"highlight searches
set hlsearch

"set the terminal color
colorscheme desert

"when you tab in the commandline it will show ist of possible completions
set wildmenu

"set color column that appears as a red line on the terminal
set colorcolumn=80

"syntax hilighting
syntax on

"disable up arrow key
"diasble down arrow key
"disable left arrow key
"diasable right arrow key
set tabstop=2    "makes tab key equal 2 spaces
set shiftwidth=2 " 

set expandtab    "convert tabs to space characters
